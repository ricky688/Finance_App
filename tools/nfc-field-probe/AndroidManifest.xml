<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hk.vibefinance.nfcprobe" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="true" />
    <application android:label="NFC 拍卡診斷" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:debuggable="true" android:supportsRtl="true">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".ProbeActivity$CaptureService" android:exported="false" android:foregroundServiceType="shortService" />
    </application>
</manifest>
